<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="license-page">
    <center><ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0" styleClass="license-scroll"><content>
        <VBox minWidth="0" spacing="12" styleClass="license-content"><padding><Insets top="22" right="24" bottom="14" left="24"/></padding>
            <Label text="%license.offline.title" styleClass="license-title"/><Label text="%license.offline.description" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="license-subtitle"/><Separator/>
            <Label fx:id="statusLabel" text="%license.offline.codeFormat" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="license-status" accessibleRoleDescription="License status"/>
            <Label text="%license.offline.code" labelFor="$licenseCode" styleClass="license-section-title"/><TextField fx:id="licenseCode" minWidth="0" promptText="FRM-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX-XXX"/>
            <Label text="%license.offline.request" labelFor="$offlineRequest" styleClass="license-section-title"/>
            <HBox minWidth="0" alignment="CENTER_LEFT" spacing="8"><TextArea fx:id="offlineRequest" minWidth="0" editable="false" wrapText="true" prefRowCount="3" HBox.hgrow="ALWAYS"/><Button fx:id="copyRequestButton" minWidth="-Infinity" text="%license.offline.copy" onAction="#copyOfflineRequest"/></HBox>
            <Label text="%license.offline.scanHelp" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="license-subtitle"/>
            <HBox minWidth="0" spacing="8" alignment="CENTER_LEFT"><TextField fx:id="activationSite" minWidth="0" editable="false" HBox.hgrow="ALWAYS" accessibleHelp="%license.offline.site"/><Button fx:id="copyActivationSiteButton" minWidth="-Infinity" text="%license.offline.copySite" onAction="#copyActivationSite"/><Button fx:id="showQrButton" minWidth="-Infinity" text="%license.offline.showQr" onAction="#showActivationQr" disable="true"/></HBox>
            <Separator/><Label text="%license.offline.license" labelFor="$offlineLicense" styleClass="license-section-title"/><Label text="%license.offline.licenseHelp" wrapText="true" minWidth="0" maxWidth="Infinity" styleClass="license-subtitle"/><TextArea fx:id="offlineLicense" minWidth="0" wrapText="true" prefRowCount="4" promptText="%license.offline.licensePrompt"/>
        </VBox>
    </content></ScrollPane></center>
    <bottom><HBox minWidth="0" alignment="CENTER_RIGHT" spacing="10" styleClass="license-actions"><padding><Insets top="12" right="24" bottom="22" left="24"/></padding><Button fx:id="openOnlineButton" minWidth="-Infinity" text="%license.online.open" onAction="#openOnline"/><Button fx:id="activateOfflineButton" minWidth="-Infinity" text="%license.offline.activateSave" onAction="#activateOffline" defaultButton="true" styleClass="primary-button"/></HBox></bottom>
</BorderPane>
